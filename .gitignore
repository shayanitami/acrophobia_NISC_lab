# ─── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / build
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# ─── Virtual environments (machine-specific, never commit) ────────────────
vret_env/
venv/
env/
.venv/
ENV/

# ─── Editor backup / swap / undo files ────────────────────────────────────
# Vim (the source of the *~ and *.un~ files in this repo)
*~
*.swp
*.swo
*.un~
.*.un~
.*.sw[a-z]

# Emacs
\#*\#
.\#*

# VS Code / JetBrains
.vscode/
.idea/

# ─── OS junk ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Local-only runtime output ────────────────────────────────────────────
# Session CSVs produced by the live pipeline (these get re-generated; not
# meaningful to track in git unless a specific session is committed as a sample)
vret_session_*.csv

# Stray terminal-output captures
*_terminal_result.txt
*_terminal_output.txt


